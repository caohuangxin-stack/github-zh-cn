{
  "manifest_version": 3,
  "name": "GitHub 中文插件",
  "version": "1.0.0",
  "description": "把 GitHub 界面汉化的浏览器插件：内置常用词库 + 可选的整页机器翻译。",
  "default_locale": "zh_CN",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "GitHub 中文插件",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://github.com/*",
    "https://translate.googleapis.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["dictionary.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
